{
  "name": "skilltree-local",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "checkpoint": "node scripts/checkpoint.mjs",
    "recovery:verify": "node scripts/recovery-verify.mjs",
    "dev": "npm run build:server && concurrently -k -n server,client \"node dist/server/main.js\" \"vite --host 127.0.0.1\"",
    "build": "npm run typecheck && npm run build:server && vite build",
    "build:prod": "npm run build",
    "build:server": "tsc -p tsconfig.node.json && tsc-alias -p tsconfig.node.json",
    "start": "node dist/server/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test:workspace": "npm run build:server && node --test scripts/test-workspace.mjs",
    "test:auth": "npm run build:server && node scripts/test-auth.mjs",
    "test:facts": "npm run build:server && node scripts/test-facts.mjs",
    "test:assessment": "npm run build:server && node scripts/test-assessment.mjs",
    "db:migrate:facts": "node scripts/migrate-facts.mjs",
    "db:migrate:mvp": "node scripts/migrate-mvp.mjs",
    "db:schema:mvp": "node scripts/gen-mvp-schema.mjs",
    "db:seed:standards": "node scripts/seed-mvp-standards.mjs",
    "db:migrate:legacy-skills": "node scripts/migrate-legacy-skills.mjs",
    "db:seed:mvp": "npm run db:migrate:mvp && npm run db:seed:enterprise && npm run db:seed:standards && npm run db:migrate:legacy-skills",
    "docs:standards": "node scripts/render-standards-draft.mjs",
    "db:seed:facts": "node scripts/seed-facts.mjs",
    "db:start": "node scripts/local-db.mjs start",
    "db:restore": "node scripts/restore-db.mjs",
    "db:check": "node scripts/check-db.mjs",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:migrate:auth": "node scripts/migrate-auth.mjs",
    "auth:create-user": "node scripts/create-local-account.mjs",
    "validation:prepare": "node scripts/validation-demo.mjs prepare",
    "validation:serve": "node scripts/validation-demo.mjs serve",
    "test:candidates": "npm run build:server && node scripts/test-candidates.mjs",
    "db:start:docker": "docker compose up -d db",
    "db:seed:enterprise": "node scripts/seed-enterprise-data.mjs > scripts/seed-enterprise-data.sql && PGPASSWORD=skilltree_local_demo psql -h 127.0.0.1 -p 55432 -U skilltree -d skilltree -f scripts/seed-enterprise-data.sql"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.20",
    "@nestjs/core": "^10.4.20",
    "@nestjs/platform-express": "^10.4.20",
    "axios": "^1.12.2",
    "dayjs": "^1.11.15",
    "dotenv": "^17.2.2",
    "drizzle-orm": "0.44.6",
    "express": "^4.21.2",
    "postgres": "^3.4.7",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.30.1",
    "react-error-boundary": "^6.0.0",
    "next-themes": "^0.4.6",
    "sonner": "^2.0.7",
    "lucide-react": "^0.554.0",
    "clsx": "~2.0.1",
    "tailwind-merge": "~3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/express": "^4.17.21",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^7.3.1",
    "typescript": "^5.9.2",
    "tsc-alias": "^1.8.16",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.13",
    "@tailwindcss/postcss": "^4.1.13",
    "@tailwindcss/typography": "^0.5.19",
    "tw-animate-css": "^1.3.8",
    "postcss": "^8.5.6",
    "autoprefixer": "^10.4.21"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
