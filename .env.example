DATABASE_URL=postgres://skilltree:skilltree_local_demo@127.0.0.1:55432/skilltree
SERVER_PORT=3001
LOCAL_DEMO=true

# MVP 认证体系开关（材料评估、L2 考核、审批、申诉等新流程）
MVP_ENABLED=true

# 真实模型：材料评估、L2 出题、简答评分、标准建议。
# 员工能力评估默认使用明确标记的模拟结果；仅 ASSESSMENT_MODE=real 且模型配置完整时调用真实模型。
ASSESSMENT_MODE=mock
# 密钥只放本机 .env，不进入前端、日志或版本控制。
AI_MODE=real
# 在模型平台创建 API Key 后填入，形如 sk-xxxxxxxx
AI_API_KEY=
# 当前适配器只接受 HTTPS 的 https://api.deepseek.com（若公司网关用同名域名，DNS 需指向该网关）
AI_BASE_URL=https://api.deepseek.com
# 本机实测该端点支持的模型名：deepseek-flash、deepseek-v4-pro。
# 填其他名字会返回 400；直连 DeepSeek 官方时用 deepseek-chat / deepseek-reasoner。
AI_MODEL=deepseek-flash

# 飞书开放平台创建自建应用后填写，并在安全设置中登记完全相同的回调地址。
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_REDIRECT_URI=http://127.0.0.1:3001/api/auth/feishu/callback
# AUTH_APP_URL=http://127.0.0.1:5173/
# HTTPS 部署时设为 true，并配套调整本机访问限制。
# AUTH_COOKIE_SECURE=false

# 服务器试用：保持监听回环地址，通过 SSH 隧道访问；LOCAL_DEMO=false 会禁用模拟成员响应。
# DEPLOYMENT_MODE=server
# AUTH_APP_URL=http://127.0.0.1:18011/
# FEISHU_MODE=real
# FEISHU_BRIDGE_URL=http://127.0.0.1:8010
# FEISHU_BRIDGE_PUBLIC_URL=http://127.0.0.1:18010
# FEISHU_BRIDGE_TOKEN=在服务器配置独立的技能树服务凭据
# FEISHU_APP_ID=
# FEISHU_TENANT_KEY=
