{
  "meta": {
    "name": "MVP 标准草稿 v1.0（三序列）",
    "date": "2026-10-20",
    "standardVersion": "v2026-q4",
    "source": "assumed",
    "scope": "仅技术类三序列：software（软件开发）、platform（平台工程）、ai（数据与 AI）。销售、客户成功、产品、项目管理等业务序列移出 MVP。",
    "note": "序列 slug、层级代码与层级名称沿用库内既有 career_sequence / career_node 定义（platform / ai 的 T1 名称本次改为按序列区分）。技能要求按层写「该层新增或提高的要求」，与既有 career_node_skill 语义一致：未列出的技能沿用较低层要求，Gap 只算本层新增/提高项。全部标记「MVP 假定标准」，管理端可改。",
    "levelRule": "职称层与技能五级是两套刻度，不强制一一对应。当前取值沿用库内既有要求（T3 出现 L3、T4 出现 L5 均为既有数据），MVP 不追求等级递进的严格合理性。",
    "requirementRule": "48 条要求全部来自库内 career_node_skill（3 序列 × 4 层 × 4 项），本次不新增、不调等级。等级与职称层级的严格匹配关系留到项目版本正式确定后再校准，MVP 只保证流程闭环可验证。"
  },
  "skillCategoriesNew": [],
  "skillsNew": [],
  "evidencePatterns": {
    "L1": [
      {
        "type": "note",
        "minCount": 1,
        "description": "学习笔记或培训记录 1 份"
      }
    ],
    "L2": [
      {
        "type": "fact",
        "minCount": 1,
        "description": "事实中心可追溯的常规任务记录 1 条"
      },
      {
        "type": "note",
        "minCount": 1,
        "description": "可复述方法与取舍的说明 1 份"
      }
    ],
    "L3": [
      {
        "type": "fact",
        "minCount": 2,
        "description": "独立承担复杂问题的项目事实 2 条"
      },
      {
        "type": "upload",
        "minCount": 1,
        "description": "方案文档或复盘材料 1 份"
      }
    ],
    "L4": [
      {
        "type": "fact",
        "minCount": 3,
        "description": "系统性方案设计或规范制定的事实 3 条"
      },
      {
        "type": "upload",
        "minCount": 1,
        "description": "被团队采用的规范/平台/工具说明 1 份"
      }
    ],
    "L5": [
      {
        "type": "fact",
        "minCount": 4,
        "description": "跨团队体系演进的事实 4 条"
      },
      {
        "type": "upload",
        "minCount": 2,
        "description": "可复用方法、工具或标准的落地证据 2 份"
      }
    ]
  },
