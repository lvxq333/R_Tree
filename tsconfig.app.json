{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "client/src/*"
      ],
      "@client/*": [
        "client/*"
      ],
      "@shared/*": [
        "shared/*"
      ]
    },
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "client/src/index.tsx",
    "shared/**/*.ts"
  ]
}